<?xml version="1.0" encoding="utf-8"?>
<!-- 横持ち配信画面: 左側に16:9プレビュー、右側に操作とステータスを配置する。 -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:padding="16dp">

    <com.pedro.library.view.OpenGlView
        android:id="@+id/camera_preview_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/streaming_controls" />

    <LinearLayout
        android:id="@+id/streaming_controls"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/camera_preview_view"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_streaming_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/streaming_title"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_streaming_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/streaming_status_idle"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/tv_latest_comment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/tv_pipeline_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/tv_latest_response"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/btn_start_stream"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/streaming_start" />

        <Button
            android:id="@+id/btn_stop_stream"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/streaming_stop" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
