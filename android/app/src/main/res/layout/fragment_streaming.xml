<?xml version="1.0" encoding="utf-8"?>
<!-- 横持ち配信画面: 左側に16:9プレビュー、右側に操作とステータスを配置する。 -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:padding="16dp">

    <com.pedro.library.view.OpenGlView
        android:id="@+id/camera_preview_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/streaming_controls" />

    <!-- 配信映像へ焼き込む下部字幕領域。透明な余白を含めて高さを制限する。 -->
    <FrameLayout
        android:id="@+id/layout_comment_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@id/camera_preview_view"
        app:layout_constraintEnd_toEndOf="@id/camera_preview_view"
        app:layout_constraintHeight_default="percent"
        app:layout_constraintHeight_percent="0.36"
        app:layout_constraintStart_toStartOf="@id/camera_preview_view"
        app:layout_constraintTop_toTopOf="@id/camera_preview_view"
        app:layout_constraintVertical_bias="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/bg_subtitle_card"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="5dp">

            <!-- 視聴者コメント枠 (文字サイズ約0.7倍: 10sp) -->
            <LinearLayout
                android:id="@+id/layout_viewer_comment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_comment_chip"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp">

                <TextView
                    android:id="@+id/tv_comment_author"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/subtitle_cyan"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_comment_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:shadowColor="#66000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="1"
                    android:text="@string/streaming_overlay_listening"
                    android:textColor="@color/subtitle_comment_text"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- ｽﾀｯｸﾁｬﾝ返答枠 (文字サイズ約0.7倍: 13sp・吹き出し風デザイン) -->
            <LinearLayout
                android:id="@+id/layout_stackchan_reply"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:background="@drawable/bg_reply_bubble"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_reply_speaker"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_speaker_badge"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="1dp"
                        android:text="@string/streaming_overlay_speaker_name"
                        android:textColor="@color/subtitle_cyan"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_reply_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textColor="@color/subtitle_thinking"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_reply_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="3"
                    android:shadowColor="#8F000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="2"
                    android:textColor="@color/subtitle_reply_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/streaming_controls"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/camera_preview_view"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_streaming_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/streaming_title"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_streaming_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/streaming_status_idle"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/tv_latest_comment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/tv_pipeline_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/tv_latest_response"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/btn_start_stream"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/streaming_start" />

        <Button
            android:id="@+id/btn_stop_stream"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/streaming_stop" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
